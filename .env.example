# Server only. For development copy to bridge/.env. Production uses dashboard env.
GROQ_API_KEY=
GROQ_MODEL=
# Default: local during development, disabled in production (no installed MATLAB).
MATLAB_MODE=local
MATLAB_BIN=
# Optional existing licensed remote bridge. Server-to-server only; HTTPS origin.
MATLAB_SERVICE_URL=
MATLAB_SERVICE_TOKEN=
# On the separately hosted processing bridge, match this to MATLAB_SERVICE_TOKEN.
MATLAB_API_TOKEN=
# Internal bridge defaults to loopback. Non-loopback requires token + HTTPS proxy.
MATLAB_BRIDGE_HOST=127.0.0.1
MATLAB_BRIDGE_PORT=3001
# Public production gateway uses Render's PORT. No VITE_* API URL is needed.
PORT=10000
LUMALAB_SSR_PORT=3002
